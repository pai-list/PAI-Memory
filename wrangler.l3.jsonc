{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "pai-memory-l3-do",
  "main": "src/l3-do-entry.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "L3_SOFT_BUDGET_MB": "100",
    "L3_HARD_CEILING_MB": "500"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "L3_FACTS_DO",
        "class_name": "L3FactGraphDO"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pai-memory-l3",
      "database_id": "483018c5-3b89-4315-9b1b-112112f7577f"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["L3FactGraphDO"]
    }
  ]
}