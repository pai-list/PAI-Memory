{
  "name": "@pai/memory",
  "description": "7-layer agent memory. Persistent. Verifiable. Shared.",
  "version": "0.1.0",
  "author": "Mohamed Abdelaziz <momtaz2727@gmail.com>",
  "bugs": {
    "url": "https://github.com/pai-list/PAI-Memory/issues"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "@types/node": "^26",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@vitest/coverage-v8": "^2.1.1",
    "eslint": "^9",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.0",
    "typedoc": "^0.27.0",
    "typescript": "^5",
    "vitest": "^2.0.0",
    "wrangler": "^4.113.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./layers": {
      "types": "./dist/layers/index.d.ts",
      "import": "./dist/layers/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./integration": {
      "types": "./dist/integration/index.d.ts",
      "import": "./dist/integration/index.js"
    }
  },
  "homepage": "https://github.com/pai-list/PAI-Memory#readme",
  "keywords": [
    "agent",
    "memory",
    "parquet",
    "r2",
    "sqlite-vec",
    "trust-chain",
    "vector"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/pai-list/PAI-Memory"
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "docs": "typedoc --out docs/api src",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "types": "dist/index.d.ts"
}
